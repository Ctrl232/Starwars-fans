# Endpoint principal del API GraphQL de Star Wars (público, sin autenticación)
SWAPI_GRAPHQL_URL=https://swapi-graphql.netlify.app/graphql
# Endpoint alterno: el proxy /api/graphql lo usa automáticamente si el principal falla
SWAPI_GRAPHQL_FALLBACK_URL=https://swapi.loquenecesito.co/graphql
# URL pública del sitio (metadatos Open Graph y URLs canónicas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
